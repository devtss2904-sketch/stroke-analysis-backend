# Application Environment
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5000

# MongoDB Connection
MONGO_URI=mongodb://127.0.0.1:27017/stroke_analysis_db

# CORS Configuration
CORS_ORIGIN=*

# Logging Configuration
LOG_LEVEL=info

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=30d

# OTP Settings
OTP_EXPIRY_MINUTES=2
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP Email Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Makefield Stroke Analysis" <noreply@makefield.com>
